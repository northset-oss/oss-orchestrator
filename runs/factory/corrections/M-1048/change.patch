+(defn replay-opponent-hand?
+  "Returns true when a hand belongs to the opponent in a player-side replay view."
+  [replay? view-side hand-side]
+  (and replay?
+       (contains? #{:corp :runner} view-side)
+       (not= view-side hand-side)))
